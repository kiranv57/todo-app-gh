# ==============================================================================
# Environment Configuration Template (.env.example)
# Zero-Fallback Secret Discipline: Mandatory secret configuration.
# Never commit real credentials to version control.
# ==============================================================================

# Cryptographic Token Signing Key (Strictly Required: No default fallback permitted)
JWT_SECRET=replace_with_a_secure_random_string_in_local_env

# Service Ports
PORT=5000
WEB_PORT=3000

# Upstream Backend API Coordinate (for Web SPA Proxy)
API_URL=http://localhost:5000

# MongoDB Storage Coordinate
MONGODB_URI=mongodb://localhost:27017/todo-db
